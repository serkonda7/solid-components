{
  "name": "@serkonda7/solid-components",
  "version": "0.4.0",
  "description": "Reusable components for SolidJS",
  "license": "MIT",
  "author": "serkonda7",
  "homepage": "https://github.com/serkonda7/solid-components",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkonda7/solid-components"
  },
  "bugs": {
    "url": "https://github.com/serkonda7/solid-components/issues"
  },
  "keywords": ["solid", "solidjs", "components", "ui"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/"],
  "scripts": {
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "typecheck": "bun check",
    "test": "vitest run",
    "examples": "vite --config examples/vite.config.ts",
    "build:dev": "bun run scripts/build.ts --dev",
    "build": "bun run typecheck && bun run scripts/build.ts --prod",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tabler/icons-solidjs": "~3.50.0",
    "@types/bun": "1.4.4",
    "@vitest/browser-playwright": "~5.0.5",
    "playwright": "~1.64.1",
    "solid-js": "~1.9.18",
    "typescript": "~7.0.2",
    "vite": "~8.3.5",
    "vite-plugin-solid": "~2.11.15",
    "vitest": "~5.0.5"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/solid-table": "~9.3.1"
  }
}
