{
  "name": "@serkonda7/solid-components",
  "version": "0.0.4",
  "description": "Reusable components for SolidJS",
  "license": "MIT",
  "author": "serkonda7",
  "homepage": "https://github.com/serkonda7/solid-components",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkonda7/solid-components"
  },
  "bugs": {
    "url": "https://github.com/serkonda7/solid-components/issues"
  },
  "keywords": ["solid", "solidjs", "components", "ui"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/"],
  "scripts": {
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "examples": "vite --config examples/vite.config.ts",
    "build:dev": "bun run scripts/build.ts --dev",
    "build": "bun run check && bun run scripts/build.ts --prod",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "^1.63.0",
    "solid-js": "~1.9.15",
    "typescript": "~7.0.2",
    "vite": "~8.3.0",
    "vite-plugin-solid": "~2.11.14",
    "vitest": "^5.0.2"
  }
}
